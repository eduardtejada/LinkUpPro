@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card shadow-sm border-0 rounded-3 p-4">
            <div class="card-body">
                <i class="bi bi-shield-slash text-danger" style="font-size: 4rem;"></i>
                <h3 class="fw-bold text-danger mt-3">Acceso Denegado</h3>
                <p class="text-muted">No cuentas con los permisos necesarios para acceder a este recurso.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 mt-2 fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Ir al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
