@{
    ViewData["Title"] = "Activación de Cuenta";
    bool hasError = ViewBag.HasError ?? false;
    string message = ViewBag.Message ?? "Estado de activación de cuenta desconocido.";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 text-center p-4">
            <div class="card-body">
                @if (!hasError)
                {
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-success mb-3">¡Cuenta Activada!</h3>
                    <p class="text-muted mb-4">@message</p>
                    <a asp-action="Login" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión Ahora
                    </a>
                }
                else
                {
                    <div class="mb-3">
                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-danger mb-3">No se pudo activar la cuenta</h3>
                    <p class="text-muted mb-4">@message</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="ResendActivation" class="btn btn-warning px-3 py-2 fw-semibold">
                            <i class="bi bi-envelope-arrow-up me-1"></i> Reenviar Correo
                        </a>
                        <a asp-action="Login" class="btn btn-outline-secondary px-3 py-2">
                            Ir al Inicio de Sesión
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
