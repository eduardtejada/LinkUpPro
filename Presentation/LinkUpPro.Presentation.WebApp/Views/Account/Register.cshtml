@model RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Únete a LinkUp Pro</h2>
                    <p class="text-muted">Conéctate con amigos y desafíalos en Batalla Naval</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Register" method="post" enctype="multipart/form-data" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="FirstName" class="form-label fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Ej. Juan" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="LastName" class="form-label fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Ej. Pérez" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="809-xxx-xxxx / 829 / 849" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="nombre@correo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="UserName" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="UserName" class="form-control" placeholder="Elige un nombre de usuario único" />
                            </div>
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Foto de Perfil <span class="text-muted fw-normal">(Opcional, máx. 5 MB)</span></label>
                            <input type="file" name="profilePicture" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text">Formatos permitidos: .jpg, .jpeg, .png, .webp.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Crea una contraseña segura" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>

                            <!-- Medidor de fortaleza de contraseña -->
                            <div class="mt-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="fw-semibold">Seguridad de la clave:</small>
                                    <span id="strengthBadge" class="badge bg-secondary">Sin evaluar</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div id="strengthProgressBar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%"></div>
                                </div>
                                <div class="mt-2 small text-muted">
                                    <div id="ruleLength"><i class="bi bi-circle me-1"></i> Mínimo 8 caracteres</div>
                                    <div id="ruleUpper"><i class="bi bi-circle me-1"></i> Al menos una letra mayúscula</div>
                                    <div id="ruleLower"><i class="bi bi-circle me-1"></i> Al menos una letra minúscula</div>
                                    <div id="ruleNumber"><i class="bi bi-circle me-1"></i> Al menos un número</div>
                                    <div id="ruleSpecial"><i class="bi bi-circle me-1"></i> Al menos un carácter especial (!@@#$%^&*)</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                <i class="bi bi-person-plus-fill me-1"></i> Registrarse
                            </button>
                        </div>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted mb-0">¿Ya tienes una cuenta? <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Inicia Sesión</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const passwordInput = document.getElementById('passwordInput');
        const progressBar = document.getElementById('strengthProgressBar');
        const strengthBadge = document.getElementById('strengthBadge');

        const ruleLength = document.getElementById('ruleLength');
        const ruleUpper = document.getElementById('ruleUpper');
        const ruleLower = document.getElementById('ruleLower');
        const ruleNumber = document.getElementById('ruleNumber');
        const ruleSpecial = document.getElementById('ruleSpecial');

        function updateRule(element, isValid) {
            if (isValid) {
                element.classList.remove('text-muted', 'text-danger');
                element.classList.add('text-success');
                element.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>' + element.textContent.trim();
            } else {
                element.classList.remove('text-success');
                element.classList.add('text-muted');
                element.innerHTML = '<i class="bi bi-circle me-1"></i>' + element.textContent.trim();
            }
        }

        passwordInput.addEventListener('input', function () {
            const val = passwordInput.value;
            let score = 0;

            const hasLength = val.length >= 8;
            const hasUpper = /[A-Z]/.test(val);
            const hasLower = /[a-z]/.test(val);
            const hasNumber = /[0-9]/.test(val);
            const hasSpecial = /[^A-Za-z0-9]/.test(val);

            updateRule(ruleLength, hasLength);
            updateRule(ruleUpper, hasUpper);
            updateRule(ruleLower, hasLower);
            updateRule(ruleNumber, hasNumber);
            updateRule(ruleSpecial, hasSpecial);

            if (hasLength) score++;
            if (hasUpper) score++;
            if (hasLower) score++;
            if (hasNumber) score++;
            if (hasSpecial) score++;

            if (val.length === 0) {
                progressBar.style.width = '0%';
                progressBar.className = 'progress-bar bg-secondary';
                strengthBadge.className = 'badge bg-secondary';
                strengthBadge.textContent = 'Sin evaluar';
            } else if (score <= 2) {
                // Débil (<= 2 criterios)
                progressBar.style.width = '33%';
                progressBar.className = 'progress-bar bg-danger';
                strengthBadge.className = 'badge bg-danger';
                strengthBadge.textContent = 'Débil';
            } else if (score <= 4) {
                // Media (3-4 criterios)
                progressBar.style.width = '66%';
                progressBar.className = 'progress-bar bg-warning text-dark';
                strengthBadge.className = 'badge bg-warning text-dark';
                strengthBadge.textContent = 'Media';
            } else {
                // Fuerte (5 criterios)
                progressBar.style.width = '100%';
                progressBar.className = 'progress-bar bg-success';
                strengthBadge.className = 'badge bg-success';
                strengthBadge.textContent = 'Fuerte';
            }
        });
    </script>
}
