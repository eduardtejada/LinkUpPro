@model ResendActivationViewModel
@{
    ViewData["Title"] = "Reenviar Activación - Copia de Facebook";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-envelope-paper-heart text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="fw-bold">Activar Cuenta</h3>
                    <p class="text-muted small">Ingresa el correo electrónico asociado a tu cuenta para enviarte un nuevo enlace.</p>
                </div>

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>@ViewBag.SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="ResendActivation" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="tu@correo.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text">Nota: Hay un tiempo de espera mínimo de 5 minutos entre envíos.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-send-fill me-1"></i> Reenviar Enlace
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <a asp-action="Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Volver a Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
