@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña - Copia de Facebook";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="fw-bold">Nueva Contraseña</h3>
                    <p class="text-muted small">Crea una nueva contraseña segura para tu cuenta.</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="ResetPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" id="resetPasswordInput" placeholder="Mínimo 8 caracteres" autofocus />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>

                        <div class="mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="fw-semibold">Seguridad:</small>
                                <span id="resetStrengthBadge" class="badge bg-secondary">Sin evaluar</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div id="resetStrengthBar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite la contraseña" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Guardar Nueva Contraseña
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <a asp-action="Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar y volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('resetPasswordInput');
        const bar = document.getElementById('resetStrengthBar');
        const badge = document.getElementById('resetStrengthBadge');

        input.addEventListener('input', function () {
            const val = input.value;
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            if (val.length === 0) {
                bar.style.width = '0%';
                badge.className = 'badge bg-secondary';
                badge.textContent = 'Sin evaluar';
            } else if (score <= 2) {
                bar.style.width = '33%';
                bar.className = 'progress-bar bg-danger';
                badge.className = 'badge bg-danger';
                badge.textContent = 'Débil';
            } else if (score <= 4) {
                bar.style.width = '66%';
                bar.className = 'progress-bar bg-warning text-dark';
                badge.className = 'badge bg-warning text-dark';
                badge.textContent = 'Media';
            } else {
                bar.style.width = '100%';
                bar.className = 'progress-bar bg-success';
                badge.className = 'badge bg-success';
                badge.textContent = 'Fuerte';
            }
        });
    </script>
}
