@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña - Copia de Facebook";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-9 col-md-7 col-lg-5" style="max-width: 480px;">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-sm-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 72px; height: 72px;">
                            <i class="bi bi-shield-lock-fill fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Nueva Contraseña</h3>
                        <p class="text-muted small">Crea una nueva contraseña segura para restablecer tu cuenta.</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="Password" class="form-control" id="resetPasswordInput" type="password" placeholder="Mínimo 8 caracteres" autofocus />
                                <button class="btn btn-outline-secondary" type="button" data-toggle-password="resetPasswordInput" title="Mostrar/ocultar contraseña" tabindex="-1">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>

                            <!-- Medidor de fortaleza de contraseña espacioso y claro -->
                            <div class="card bg-light border-0 p-3 mt-3 rounded-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-semibold text-secondary">Seguridad de la clave:</span>
                                    <span id="resetStrengthBadge" class="badge bg-secondary">Sin evaluar</span>
                                </div>
                                <div class="progress mb-2" style="height: 6px;">
                                    <div id="resetStrengthBar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%"></div>
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 0.82rem;">
                                    <div id="resetRuleLength" class="mb-1"><i class="bi bi-circle me-1"></i> Mínimo 8 caracteres</div>
                                    <div id="resetRuleUpper" class="mb-1"><i class="bi bi-circle me-1"></i> Al menos una letra mayúscula</div>
                                    <div id="resetRuleLower" class="mb-1"><i class="bi bi-circle me-1"></i> Al menos una letra minúscula</div>
                                    <div id="resetRuleNumber" class="mb-1"><i class="bi bi-circle me-1"></i> Al menos un número</div>
                                    <div id="resetRuleSpecial"><i class="bi bi-circle me-1"></i> Al menos un carácter especial (!@@#$%^&*)</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" id="confirmResetPasswordInput" type="password" placeholder="Repite la contraseña" />
                                <button class="btn btn-outline-secondary" type="button" data-toggle-password="confirmResetPasswordInput" title="Mostrar/ocultar contraseña" tabindex="-1">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Guardar Nueva Contraseña
                            </button>
                            <a asp-action="Login" class="btn btn-outline-secondary py-2">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar y volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle Mostrar / Ocultar Contraseña
        document.querySelectorAll('[data-toggle-password]').forEach(button => {
            button.addEventListener('click', function () {
                const targetId = this.getAttribute('data-toggle-password');
                const targetInput = document.getElementById(targetId);
                const icon = this.querySelector('i');
                if (targetInput.type === 'password') {
                    targetInput.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    targetInput.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });

        // Medidor de fortaleza en tiempo real
        const input = document.getElementById('resetPasswordInput');
        const bar = document.getElementById('resetStrengthBar');
        const badge = document.getElementById('resetStrengthBadge');

        const ruleLength = document.getElementById('resetRuleLength');
        const ruleUpper = document.getElementById('resetRuleUpper');
        const ruleLower = document.getElementById('resetRuleLower');
        const ruleNumber = document.getElementById('resetRuleNumber');
        const ruleSpecial = document.getElementById('resetRuleSpecial');

        function updateRule(element, passed) {
            if (passed) {
                element.className = 'mb-1 text-success fw-semibold';
                element.querySelector('i').className = 'bi bi-check-circle-fill me-1 text-success';
            } else {
                element.className = 'mb-1 text-muted';
                element.querySelector('i').className = 'bi bi-circle me-1 text-muted';
            }
        }

        input.addEventListener('input', function () {
            const val = input.value;
            const hasLen = val.length >= 8;
            const hasUpper = /[A-Z]/.test(val);
            const hasLower = /[a-z]/.test(val);
            const hasNum = /[0-9]/.test(val);
            const hasSpecial = /[^A-Za-z0-9]/.test(val);

            updateRule(ruleLength, hasLen);
            updateRule(ruleUpper, hasUpper);
            updateRule(ruleLower, hasLower);
            updateRule(ruleNumber, hasNum);
            updateRule(ruleSpecial, hasSpecial);

            let score = (hasLen ? 1 : 0) + (hasUpper ? 1 : 0) + (hasLower ? 1 : 0) + (hasNum ? 1 : 0) + (hasSpecial ? 1 : 0);

            if (val.length === 0) {
                bar.style.width = '0%';
                badge.className = 'badge bg-secondary';
                badge.textContent = 'Sin evaluar';
            } else if (score <= 2) {
                bar.style.width = '33%';
                bar.className = 'progress-bar bg-danger';
                badge.className = 'badge bg-danger';
                badge.textContent = 'Débil';
            } else if (score <= 4) {
                bar.style.width = '66%';
                bar.className = 'progress-bar bg-warning text-dark';
                badge.className = 'badge bg-warning text-dark';
                badge.textContent = 'Media';
            } else {
                bar.style.width = '100%';
                bar.className = 'progress-bar bg-success';
                badge.className = 'badge bg-success';
                badge.textContent = 'Fuerte';
            }
        });
    </script>
}
