@model BattleshipIndexViewModel
@{
    ViewData["Title"] = "Battleship (Batalla Naval)";
}

<!-- Mensajes de feedback -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Banner de Encabezado Battleship -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-dark text-white overflow-hidden position-relative" style="background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);">
    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-crosshair fs-2 text-warning"></i>
                <h3 class="fw-bold mb-0">Battleship</h3>
            </div>
            <p class="mb-0 opacity-75">
                Despliega tu flota, coordina tus ataques por turnos y compite contra tus amigos en altamar.
            </p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary p-2 d-flex align-items-center gap-1">
                <i class="bi bi-shield"></i> 5 Naves
            </span>
            <span class="badge bg-danger p-2 d-flex align-items-center gap-1">
                <i class="bi bi-clock"></i> 48h por Turno
            </span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Columna Principal: Partidas Activas e Historial -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom p-0">
                <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="battleshipTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeGames" type="button" role="tab" aria-controls="activeGames" aria-selected="true">
                            <i class="bi bi-joystick me-1 text-primary"></i> Partidas en Curso
                            <span class="badge bg-primary rounded-pill ms-1">@Model.ActiveGames.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="history-tab" data-bs-toggle="tab" data-bs-target="#finishedGames" type="button" role="tab" aria-controls="finishedGames" aria-selected="false">
                            <i class="bi bi-trophy me-1 text-warning"></i> Historial Finalizado
                            <span class="badge bg-secondary rounded-pill ms-1">@Model.FinishedGames.Count</span>
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4">
                <div class="tab-content" id="battleshipTabsContent">
                    <!-- Pestaña 1: Partidas Activas -->
                    <div class="tab-pane fade show active" id="activeGames" role="tabpanel" aria-labelledby="active-tab">
                        @if (!Model.ActiveGames.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-water text-primary fs-1 mb-3 d-block opacity-50"></i>
                                <h5 class="fw-bold text-muted">No tienes partidas en curso</h5>
                                <p class="text-muted small mb-3">Reta a uno de tus amigos activos en la lista lateral para iniciar una batalla naval.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var game in Model.ActiveGames)
                                {
                                    <div class="border rounded-3 p-3 shadow-sm hover-shadow transition">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(game.OpponentProfilePictureUrl) ? "/images/default-avatar.png" : game.OpponentProfilePictureUrl)" 
                                                     alt="@game.OpponentFullName" 
                                                     class="rounded-circle object-fit-cover border" 
                                                     style="width: 50px; height: 50px;" />
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark">@game.OpponentFullName</h6>
                                                    <small class="text-muted">@@@game.OpponentUserName</small>
                                                    <div class="mt-1">
                                                        <small class="text-muted">
                                                            <i class="bi bi-calendar3 me-1"></i>Iniciada: @game.CreatedAt.ToString("g")
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex flex-column align-items-end gap-2">
                                                @if (game.Status == GameStatus.Placement)
                                                {
                                                    <span class="badge bg-info text-dark px-3 py-2">
                                                        <i class="bi bi-grid-3x3 me-1"></i>Fase 1: Posicionamiento
                                                    </span>

                                                    @if (game.IsReady)
                                                    {
                                                        <span class="badge bg-light text-muted border">
                                                            <i class="bi bi-hourglass-split me-1"></i>Esperando al rival...
                                                        </span>
                                                        <a asp-action="Placement" asp-route-id="@game.GameId" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-eye me-1"></i>Ver Mi Flota
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="Placement" asp-route-id="@game.GameId" class="btn btn-sm btn-warning text-dark fw-bold">
                                                            <i class="bi bi-pencil-square me-1"></i>Colocar Mis Barcos
                                                        </a>
                                                    }
                                                }
                                                else if (game.Status == GameStatus.InProgress)
                                                {
                                                    @if (game.IsMyTurn)
                                                    {
                                                        <span class="badge bg-success px-3 py-2 animate-pulse">
                                                            <i class="bi bi-lightning-charge-fill me-1"></i>¡Es Tu Turno!
                                                        </span>
                                                        <a asp-action="Play" asp-route-id="@game.GameId" class="btn btn-sm btn-danger fw-bold shadow-sm">
                                                            <i class="bi bi-crosshair me-1"></i>¡Al Combate!
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary px-3 py-2">
                                                            <i class="bi bi-hourglass-bottom me-1"></i>Turno del Rival
                                                        </span>
                                                        <a asp-action="Play" asp-route-id="@game.GameId" class="btn btn-sm btn-outline-secondary">
                                                            <i class="bi bi-binoculars me-1"></i>Ver Tablero
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Pestaña 2: Historial Finalizado -->
                    <div class="tab-pane fade" id="finishedGames" role="tabpanel" aria-labelledby="history-tab">
                        @if (!Model.FinishedGames.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-archive text-secondary fs-1 mb-3 d-block opacity-50"></i>
                                <h5 class="fw-bold text-muted">No tienes partidas terminadas</h5>
                                <p class="text-muted small mb-0">Cuando concluya un combate, podrás consultar aquí el registro y los tableros finales.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var game in Model.FinishedGames)
                                {
                                    <div class="border rounded-3 p-3 shadow-sm bg-light">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(game.OpponentProfilePictureUrl) ? "/images/default-avatar.png" : game.OpponentProfilePictureUrl)" 
                                                     alt="@game.OpponentFullName" 
                                                     class="rounded-circle object-fit-cover border" 
                                                     style="width: 45px; height: 45px;" />
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark">Contra: @game.OpponentFullName</h6>
                                                    <small class="text-muted">
                                                        Finalizada: @(game.FinishedAt?.ToString("g") ?? game.CreatedAt.ToString("g"))
                                                    </small>
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center gap-3">
                                                <div>
                                                    @if (game.DidIWin == true)
                                                    {
                                                        <span class="badge bg-success fs-6 px-3 py-2">
                                                            <i class="bi bi-trophy-fill me-1"></i>Victoria
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger fs-6 px-3 py-2">
                                                            <i class="bi bi-x-circle-fill me-1"></i>Derrota
                                                        </span>
                                                    }
                                                    <div class="text-end mt-1">
                                                        <small class="text-muted">
                                                            @switch (game.EndReason)
                                                            {
                                                                case GameEndReason.AllShipsSunk:
                                                                    <span>Flota Hundida</span>
                                                                    break;
                                                                case GameEndReason.Surrendered:
                                                                    <span>Rendición</span>
                                                                    break;
                                                                case GameEndReason.TimedOut48h:
                                                                    <span>Inactividad (+48h)</span>
                                                                    break;
                                                                default:
                                                                    <span>Concluida</span>
                                                                    break;
                                                            }
                                                        </small>
                                                    </div>
                                                </div>

                                                <a asp-action="HistoryDetails" asp-route-id="@game.GameId" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye me-1"></i>Ver Tableros
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Lateral: Retar a un Amigo Activo -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-3 sticky-top" style="top: 85px;">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-swords text-danger me-2"></i>Retar a un Amigo
                </h5>
                <span class="badge bg-light text-dark border">@Model.AvailableFriends.Count disponibles</span>
            </div>

            <div class="card-body p-3" style="max-height: 600px; overflow-y: auto;">
                @if (!Model.AvailableFriends.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-people fs-2 mb-2 d-block opacity-50"></i>
                        <p class="small mb-2">No tienes amigos disponibles para retar en este momento.</p>
                        <small class="text-muted d-block mb-3">Esto ocurre si ya estás jugando con todos tus amigos activos o aún no tienes amigos.</small>
                        <a asp-controller="Friends" asp-action="Requests" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-person-plus me-1"></i>Buscar Nuevos Amigos
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var friend in Model.AvailableFriends)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 border bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(friend.ProfilePictureUrl) ? "/images/default-avatar.png" : friend.ProfilePictureUrl)" 
                                         alt="@friend.FullName" 
                                         class="rounded-circle object-fit-cover border" 
                                         style="width: 40px; height: 40px;" />
                                    <div>
                                        <div class="fw-semibold text-dark small text-truncate" style="max-width: 140px;">@friend.FullName</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 140px;">@@@friend.UserName</small>
                                    </div>
                                </div>

                                <form asp-action="Challenge" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="opponentId" value="@friend.UserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold">
                                        <i class="bi bi-crosshair me-1"></i>Retar
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
