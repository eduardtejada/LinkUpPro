<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Copia de Facebook</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LinkUpPro.Presentation.WebApp.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-fb shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-facebook fs-2 me-2 text-white"></i>
                    <span>Copia de Facebook</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door-fill me-1"></i> Publicaciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Friends" asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i> Amigos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold position-relative" asp-controller="Friends" asp-action="Requests">
                                    <i class="bi bi-person-plus-fill me-1"></i> Solicitudes
                                    <span id="friendRequestsBadge" class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                        0
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Battleship" asp-action="Index">
                                    <i class="bi bi-crosshair me-1"></i> Battleship
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold position-relative" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell-fill me-1"></i> Notificaciones
                                    <span id="notificationsBadge" class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-warning text-dark d-none">
                                        0
                                    </span>
                                </a>
                            </li>
                        </ul>

                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center fw-semibold" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-1"></i>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge me-2"></i> Mi Perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key me-2"></i> Cambiar Contraseña
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-menu-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary fw-bold px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i> Crear Cuenta Nueva
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                fetch('/Notifications/GetCounts')
                    .then(response => {
                        if (response.ok) return response.json();
                        return null;
                    })
                    .then(data => {
                        if (!data) return;
                        const reqBadge = document.getElementById('friendRequestsBadge');
                        const notifBadge = document.getElementById('notificationsBadge');

                        if (reqBadge && data.pendingRequests > 0) {
                            reqBadge.textContent = data.pendingRequests;
                            reqBadge.classList.remove('d-none');
                        }

                        if (notifBadge && data.unreadNotifications > 0) {
                            notifBadge.textContent = data.unreadNotifications;
                            notifBadge.classList.remove('d-none');
                        }
                    })
                    .catch(err => console.error('Error cargando badges:', err));
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
